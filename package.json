{
  "name": "appdock-at365",
  "version": "0.15.0",
  "private": true,
  "description": "AppDock.at365",
  "author": "at365",
  "license": "UNLICENSED",
  "main": "out/main/main/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "pnpm run build && electron .",
    "test": "pnpm run build && pnpm run build:test-extensions && node --test tests/*.test.cjs",
    "build:test-extensions": "node scripts/build-test-extensions.cjs",
    "build:dotnet": "node scripts/build-dotnet.cjs",
    "dist": "pnpm run build:dotnet && pnpm run build && electron-builder --win portable --x64",
    "smoke": "node scripts/smoke.cjs",
    "test:ui": "pnpm run build:test-extensions && node scripts/ui-test.cjs",
    "test:navigation": "pnpm run build:test-extensions && node scripts/navigation-ui-test.cjs",
    "test:preferences": "pnpm run build:test-extensions && node scripts/preferences-ui-test.cjs",
    "test:hotkeys": "pnpm run build:test-extensions && node scripts/hotkeys-ui-test.cjs",
    "test:window-state": "node scripts/window-state-ui-test.cjs",
    "test:host-commands": "node scripts/host-commands-ui-test.cjs",
    "test:tray": "node scripts/tray-commands-ui-test.cjs",
    "test:hardware-acceleration": "node scripts/hardware-acceleration-ui-test.cjs",
    "test:applet-sidebar": "node scripts/applet-sidebar-ui-test.cjs",
    "format": "prettier --write --ignore-path .gitignore src scripts tests",
    "test:widgets": "node scripts/widgets-ui-test.cjs",
    "test:widget-desktop": "node scripts/widget-desktop-visibility-test.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "at365.appdock",
    "productName": "AppDock.at365",
    "executableName": "AppDock.at365",
    "directories": {
      "output": "publish",
      "buildResources": "assets"
    },
    "files": [
      "out/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "artifacts/dotnet-host",
        "to": "dotnet-host"
      },
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "AppDock.at365.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": false
    }
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
